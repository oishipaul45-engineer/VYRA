import { Canvas, useFrame } from '@react-three/fiber';
import { useRef } from 'react';
import * as THREE from 'three';

type Props = { tone: string; reducedMotion: boolean };
function Core({ tone, reducedMotion }: Props) {
  const group = useRef<THREE.Group>(null);
  const orb = useRef<THREE.Mesh>(null);
  useFrame(({ clock }) => {
    if (reducedMotion) return;
    const t = clock.elapsedTime;
    if (group.current) { group.current.rotation.y = t * 0.13; group.current.rotation.z = Math.sin(t * .35) * .11; }
    if (orb.current) orb.current.scale.setScalar(1 + Math.sin(t * 1.1) * .025);
  });
  return <group ref={group}>
    <mesh ref={orb}><icosahedronGeometry args={[1.4, 9]}/><meshPhysicalMaterial color={tone} roughness={.12} metalness={.2} clearcoat={1} clearcoatRoughness={.08} transmission={.28} thickness={1.1} emissive={tone} emissiveIntensity={.25}/></mesh>
    <mesh rotation={[1.12,.4,.3]}><torusGeometry args={[1.98,.013,12,180]}/><meshBasicMaterial color="#7cfff1" transparent opacity={.75}/></mesh>
    <mesh rotation={[.3,1,.4]}><torusGeometry args={[2.15,.012,12,180]}/><meshBasicMaterial color="#e6b2ff" transparent opacity={.65}/></mesh>
    <mesh rotation={[2.1,.7,1]}><torusGeometry args={[1.82,.009,12,180]}/><meshBasicMaterial color="#ff977f" transparent opacity={.6}/></mesh>
    <mesh position={[2.05,.5,.2]}><sphereGeometry args={[.075,20,20]}/><meshBasicMaterial color="#77fff1"/></mesh>
    <mesh position={[-1.8,-.95,.5]}><sphereGeometry args={[.055,20,20]}/><meshBasicMaterial color="#ff977f"/></mesh>
  </group>;
}
export default function MoneyCore({ tone, reducedMotion }: Props) {
  return <div className="core-canvas" role="img" aria-label="Decorative glass sphere surrounded by orbiting rings">
    <Canvas dpr={[1,1.6]} camera={{ position: [0,0,6.2], fov: 42 }} gl={{ alpha:true, antialias:true }} fallback={<div className="core-fallback"/>}>
      <ambientLight intensity={1.4}/><pointLight position={[3,4,5]} color="#ffffff" intensity={75}/><pointLight position={[-4,-2,1]} color="#7ee7f0" intensity={40}/><Core tone={tone} reducedMotion={reducedMotion}/>
    </Canvas>
  </div>;
}
